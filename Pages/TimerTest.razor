@page "/"
@page "/timer-test"
@layout EmptyLayout
@using CubeSpinner.Layout
@using CubeSpinner
@inject IJSRuntime JS
@implements IAsyncDisposable

<h3>Timer Test Page (rough)</h3>

<div class="timer-container @StateClass">
    <div class="timer-display">
        @FormattedTime
    </div>
    <div class="timer-state">
        State: @Timer.State
    </div>
    <div class="timer-hint">
        Hold Space, release to start. Space again to stop.
    </div>
</div>

@code {
    private Timer Timer = new();
    private IJSObjectReference? _module;
    private DotNetObjectReference<TimerTest>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Timer.Statechanged += HandleStateChanged;

            // adjust the path below to match where keyinput.js actually lives
            // (your project shows it under wwwroot/js/keyinput.js)
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/keyinput.js");

            _dotNetRef = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("initialize", _dotNetRef);
        }
    }

    // These must match the method names keyinput.js calls via
    // dotNetRef.invokeMethodAsync("OnSpaceDown" / "OnSpaceUp")
    [JSInvokable]
    public void OnSpaceDown()
    {
        Timer.spaceDown();
    }

    [JSInvokable]
    public void OnSpaceUp()
    {
        Timer.spaceUp();
    }

    private void HandleStateChanged()
    {
        // Poll() runs on a thread-pool timer thread, not Blazor's render thread,
        // so this must go through InvokeAsync rather than calling StateHasChanged() directly
        InvokeAsync(StateHasChanged);
    }

    private string FormattedTime =>
        Timer.State is timerState.isRunning or timerState.isStopped
            ? Timer.ElapsedTime.ToString(@"mm\:ss\.ff")
            : "0:00.00";

    private string StateClass => Timer.State switch
    {
        timerState.isIdle => "state-idle",
        timerState.isReady => "state-ready",
        timerState.isRunning => "state-running",
        timerState.isStopped => "state-stopped",
        timerState.isInspecting => "state-inspecting",
        _ => ""
    };

    public async ValueTask DisposeAsync()
    {
        Timer.Statechanged -= HandleStateChanged;

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("dispose");
            await _module.DisposeAsync();
        }

        _dotNetRef?.Dispose();
    }
}

<style>
    .timer-container {
        text-align: center;
        padding: 3rem;
        border-radius: 12px;
        transition: background-color 0.15s ease;
        background-color: #1e1e1e;
        color: white;
        font-family: monospace;
    }

    .timer-display {
        font-size: 4rem;
        font-weight: bold;
    }

    .timer-state, .timer-hint {
        margin-top: 0.5rem;
        opacity: 0.7;
        font-size: 0.9rem;
    }

    /* not yet armed / reset */
    .state-idle, .state-stopped {
        background-color: #1e1e1e;
    }

    /* held, still waiting on the delay threshold */
    .state-inspecting {
        background-color: #7a1f1f; /* red-ish: not ready yet */
    }

    /* delay threshold passed, releasing will start the clock */
    .state-ready {
        background-color: #1f7a2f; /* green: go */
    }

    /* actively timing */
    .state-running {
        background-color: #1e1e1e;
        color: #4caf50;
    }
</style>
